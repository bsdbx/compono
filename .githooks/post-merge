#!/bin/sh

# post-checkout passes "0" as $3 for file checkouts, which can't change dependencies.
[ "${3-1}" = 0 ] && exit 0

# Where uv's installer puts uv, for Git clients that don't load the shell profile.
PATH="$PATH:${XDG_BIN_HOME:-$HOME/.local/bin}"

# Sync `.venv` to `uv.lock` while ensuring the lockfile is never rewritten
uv --directory backend sync --locked -q
