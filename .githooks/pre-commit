#!/bin/sh

# Where uv's installer puts uv, for Git clients that don't load the shell profile.
PATH="$PATH:${XDG_BIN_HOME:-$HOME/.local/bin}"
# Where pnpm's installer puts pnpm, on Linux and on macOS.
PATH="$PATH:${XDG_DATA_HOME:-$HOME/.local/share}/pnpm/bin:$HOME/Library/pnpm/bin"

# Find the repo and tmp snapshot folder
# Remove the tmp folder on exit, kill, KeyboardInterrupt, ...
repo=$(git rev-parse --show-toplevel) || exit 1
snapshot=$(mktemp -d) || exit 1
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM

# Git for Windows needs a Windows-style path here; cygpath only exists there.
git checkout-index -a --prefix="$(cygpath -m "$snapshot" 2>/dev/null || echo "$snapshot")/" || exit 1
cd "$snapshot" || exit 1

status=0
fixable=0 # set when a check that ./format.sh can fix fails
# check COMMAND...: runs it, and shows its output only if it fails.
check() {
	if ! output=$("$@" 2>&1); then
		printf '%s\n' "$output"
		status=1
		return 1
	fi
}
# tool COMMAND...: runs a tool from backend/.venv without changing uv.lock.
tool() { check uv run -q --frozen --project "$repo/backend" "$@"; }

# If staged `uv.lock` doesn't match staged `pyproject.toml` - warn and encourage to stage both
if ! output=$(uv lock --check --project backend 2>&1); then
	printf '%s\n' "$output" 'Run "uv lock" in backend/, then stage both pyproject.toml and uv.lock.'
	status=1
fi

# If staged `pnpm-lock.yaml` doesn't match staged `package.json` - warn and encourage to stage both.
# Offline and without the release-age policy, which `pnpm add` already applied, so it needs no network.
if ! command -v pnpm >/dev/null 2>&1; then
	echo 'pnpm is missing. Run ./install.sh, then commit again.'
	status=1
elif ! output=$(pnpm --dir frontend install --frozen-lockfile --lockfile-only --offline --config.minimum-release-age=0 2>&1); then
	printf '%s\n' "$output" 'Run "pnpm install" in frontend/, then stage both package.json and pnpm-lock.yaml.'
	status=1
fi

# Run formatting checks
tool ruff check || fixable=1
tool ruff format --check || fixable=1
tool tombi format --check || fixable=1
tool rumdl fmt --check || fixable=1
tool shfmt -d . || fixable=1

# Check spelling. Not fixed by `./format.sh` on purpose
tool typos --format brief

# Run mypy check from `backend` directory
tool --directory backend mypy --cache-dir "$repo/backend/.mypy_cache"

# Run the frontend's checks with its installed dependencies, which the snapshot doesn't have.
# After the other checks, so that they don't see frontend/node_modules. On Windows, linking needs Developer Mode.
if [ ! -d "$repo/frontend/node_modules" ]; then
	echo 'frontend/node_modules is missing. Run ./install.sh, then commit again.'
	status=1
elif MSYS=winsymlinks:nativestrict ln -s "$repo/frontend/node_modules" frontend/node_modules; then
	PATH="$repo/frontend/node_modules/.bin:$PATH"
	check biome check --error-on-warnings || fixable=1
	check next typegen frontend
	check tsc --noEmit --project frontend
	check vitest run --root frontend

	# If the API client doesn't match the backend's OpenAPI description - say how to update it.
	# Generates both again here: PYTHONPATH imports the snapshot's backend instead of the working tree's.
	before=$(find frontend/openapi.json frontend/src/api -type f -exec cksum {} + | sort)
	check sh -c 'PYTHONPATH="$1/backend/src" uv run -q --frozen --project "$2/backend" compono-openapi > frontend/openapi.json && cd frontend && openapi-ts --silent' sh "$snapshot" "$repo"
	if [ "$before" != "$(find frontend/openapi.json frontend/src/api -type f -exec cksum {} + | sort)" ]; then
		echo 'The API client is out of date. Run "pnpm generate" in frontend/, then stage the changes.'
		status=1
	fi
else
	echo 'Could not link frontend/node_modules into the snapshot. On Windows, turn on Developer Mode.'
	status=1
fi

# If there was anything to fix - suggest running ./format.sh
[ $fixable -eq 0 ] || echo 'Run ./format.sh to fix what it can automatically, then stage the changes.'

exit $status
