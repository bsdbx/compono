{
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.readonlyInclude": { "**/uv.lock": true },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": { "source.organizeImports.ruff": "explicit" }
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl",
    "files.trimTrailingWhitespace": false
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[mako]": {
    "editor.formatOnSave": false
  },
  "css.lint.unknownAtRules": "ignore",
  "[css][javascript][javascriptreact][json][jsonc][typescript][typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
  },
  "biome.lsp.bin": {
    "darwin-arm64": "frontend/node_modules/.bin/biome",
    "darwin-x64": "frontend/node_modules/.bin/biome",
    "linux-arm64": "frontend/node_modules/.bin/biome",
    "linux-x64": "frontend/node_modules/.bin/biome",
    "win32-arm64": "frontend/node_modules/.bin/biome.cmd",
    "win32-x64": "frontend/node_modules/.bin/biome.cmd"
  },
  "shfmt.executablePath": "uv",
  "shfmt.executableArgs": [
    "run",
    "-q",
    "--frozen",
    "--project",
    "backend",
    "shfmt"
  ],
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "**/uv.lock"
  ],
  "cSpell.words": [
    "_refuse_unstorable",
    "addopts",
    "anyascii",
    "argjson",
    "autostash",
    "Bohdan",
    "brakkk9",
    "bsdbx",
    "btrim",
    "cksum",
    "cntrl",
    "compono",
    "conftest",
    "conname",
    "connamespace",
    "contype",
    "datablock",
    "dbname",
    "drivername",
    "elif",
    "fastapi",
    "filterwarnings",
    "healthcheck",
    "httpx2",
    "jsonable_encoder",
    "Koshovenko",
    "Kovalenko",
    "ltrimstr",
    "mypy",
    "nativestrict",
    "northwind",
    "ondelete",
    "onupdate",
    "outerjoin",
    "pg_get_constraintdef",
    "pg_isready",
    "pipefail",
    "pooler",
    "psycopg",
    "pwdlib",
    "pycache",
    "pydantic",
    "pyproject",
    "pytest",
    "PYTHONPATH",
    "redoc",
    "regnamespace",
    "repr",
    "rumdl",
    "sayt",
    "sessionmaker",
    "shadcn",
    "shfmt",
    "sqlalchemy",
    "sslmode",
    "startswith",
    "tbls",
    "testpaths",
    "tombi",
    "toplevel",
    "turbopack",
    "typegen",
    "unassigns",
    "unpooled",
    "uuidv",
    "uvicorn",
    "varchar",
    "venv",
    "Vercel",
    "vitest",
    "winsymlinks",
    "Yevhenii",
    "Маркетинг",
    "сайт"
  ],
  "cSpell.ignoreWords": ["Rollup"]
}
